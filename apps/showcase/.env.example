# Copy to .env.local for machine-specific overrides. .env.local is gitignored.
#
# Every VITE_* variable is compiled into the JavaScript bundle and is PUBLIC.
# Never put API secrets, database passwords or private keys here: keep them on the server.

# Base URL of the REST API, without a trailing slash.
VITE_API_BASE_URL=/api

# development | staging | production | test
VITE_APP_ENV=development

# true serves the API from Mock Service Worker in the browser (no backend needed).
VITE_ENABLE_MOCKS=true

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=10000

# Optional error-reporting endpoint (public DSN only).
VITE_ERROR_REPORTING_DSN=
