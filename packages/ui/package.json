{
  "name": "@vue-js-spa-components/ui",
  "version": "0.0.0",
  "description": "Accessible Vue 3 components with a clean, system-native look.",
  "author": "MD Rumman Hossain",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rumman-hossain/vue-js-spa-components.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src/tokens/theme.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./theme.css": "./src/tokens/theme.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && publint",
    "typecheck": "vue-tsc --noEmit -p jsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "axe-core": "^4.14.0",
    "publint": "^0.3.25",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vue": "3.5.44"
  }
}
